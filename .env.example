# ============================================================
# PGP - EXEMPLO DE VARIAVEIS DE AMBIENTE
# ============================================================
# Este arquivo pode ser versionado.
# NUNCA coloque aqui senhas, chaves ou URLs reais de producao.
#
# O arquivo real .env permanece ignorado pelo Git.


# ------------------------------------------------------------
# DJANGO / AMBIENTE
# ------------------------------------------------------------

SECRET_KEY=
DEBUG=False

# Desenvolvimento local:
# deixe DATABASE_URL vazia para usar db.sqlite3.
#
# Homologacao:
# DATABASE_URL=sqlite:///caminho/do/banco.sqlite3
#
# Producao:
# use a URL PostgreSQL fornecida pelo provedor.
DATABASE_URL=

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

PGP_AMBIENTE_DEMO=False
PGP_DATA_DIR=

PGP_SESSION_IDLE_MINUTES=60
PGP_MAX_UPLOAD_MB=20


# ------------------------------------------------------------
# ADMINISTRADOR INICIAL DE PRODUCAO
# ------------------------------------------------------------

# Usados somente para criar o primeiro superusuario.
# Em deploys posteriores a senha nao e redefinida.
PGP_ADMIN_USERNAME=
PGP_ADMIN_EMAIL=
PGP_ADMIN_PASSWORD=


# ------------------------------------------------------------
# HTTPS / SEGURANCA
# ------------------------------------------------------------

SECURE_SSL_REDIRECT=False

# Ative HSTS somente quando o dominio estiver definitivamente
# operando exclusivamente em HTTPS.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False


# ------------------------------------------------------------
# IA EXTERNA
# ------------------------------------------------------------

PGP_IA_ATIVA=False
OPENAI_API_KEY=
PGP_IA_MODELO=gpt-6-luna
PGP_IA_LIMITE_PAGINAS=10
PGP_IA_LIMITE_TAMANHO_MB=15
PGP_IA_ANONIMIZAR=True
